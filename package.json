{
  "name": "passbolt_api",
  "version": "5.0.0",
  "description": "The backend application for the open source password manager for teams",
  "repository": {
    "url": "https://github.com/passbolt/passbolt_api"
  },
  "engines": {
    "node": ">=16.14.0",
    "npm": ">=8.3.1"
  },
  "keywords": [
    "passbolt",
    "API"
  ],
  "author": "Passbolt SA",
  "license": "AGPL-3.0",
  "homepage": "https://www.passbolt.com",
  "devDependencies": {
    "lockfile-lint": "^5.0.1",
    "openpgp": "^5.11.3",
    "passbolt-styleguide": "^5.18.0-alpha.0"
  },
  "scripts": {
    "copy:dependencies": "node ./scripts/copy-dependencies.js",
    "copy:styleguide": "node ./scripts/copy-styleguide.js",
    "copy:locales": "node ./scripts/copy-locales.js",
    "lint": "npm run lint:lockfile",
    "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts npm github.com --allowed-schemes \"https:\" \"git+ssh:\" --empty-hostname false"
  }
}
